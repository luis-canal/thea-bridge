{
  "manifest_version": 3,
  "name": "TheaBridge",
  "version": "0.1.0",
  "description": "Importe conteúdos do GitBook para seus Study Kits do Thea.",
  "action": {
    "default_title": "Abrir TheaBridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "https://www.thea.study/*",
    "https://*.gitbook.io/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}